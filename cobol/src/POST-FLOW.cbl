>>SOURCE FORMAT FREE
*> Post 0-flow and 1-flow lines from flows.csv into a 96-byte journal.
IDENTIFICATION DIVISION.
PROGRAM-ID. POST-FLOW.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FLOW-FILE ASSIGN TO "flows.csv"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS FLOW-STATUS.
    SELECT JOURNAL-FILE ASSIGN TO "journal.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS JRNL-STATUS.
    SELECT JOURNAL-CSV ASSIGN TO "journal.csv"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS CSV-STATUS.

DATA DIVISION.
FILE SECTION.
FD FLOW-FILE.
01 FLOW-LINE PIC X(192).

FD JOURNAL-FILE
    RECORD CONTAINS 96 CHARACTERS.
01 JOURNAL-LINE PIC X(96).

FD JOURNAL-CSV.
01 CSV-LINE PIC X(192).

WORKING-STORAGE SECTION.
COPY JOURNAL.

01 FLOW-STATUS PIC XX VALUE "00".
01 JRNL-STATUS PIC XX VALUE "00".
01 CSV-STATUS PIC XX VALUE "00".
01 WS-EOF PIC X VALUE "N".
01 WS-HEADER-SKIP PIC X VALUE "Y".
01 WS-JE PIC 9(8) VALUE 0.
01 WS-DIM-X PIC X(4).
01 WS-DIM PIC 9 VALUE 0.
01 WS-DEBIT PIC X(16).
01 WS-CREDIT PIC X(16).
01 WS-YEAR-X PIC X(8).
01 WS-YEAR PIC 9(4) VALUE 2020.
01 WS-AMT-X PIC X(12).
01 WS-AMT PIC 9(10) VALUE 100.
01 WS-MEMO PIC X(36).
01 WS-DATE PIC 9(8).
01 WS-PTR PIC 999.
01 WS-FIELD PIC X(48).
01 WS-FCOUNT PIC 99.
01 WS-CSV-ID PIC 9(8).

PROCEDURE DIVISION.
MAIN-SECTION.
    SET ENVIRONMENT "COB_LS_FIXED" TO "Y"
    OPEN INPUT FLOW-FILE
    IF FLOW-STATUS NOT = "00"
        DISPLAY "POST-FLOW: cannot open flows.csv status=" FLOW-STATUS
        STOP RUN
    END-IF
    OPEN OUTPUT JOURNAL-FILE
    OPEN OUTPUT JOURNAL-CSV
    MOVE "je_id,date,dim,debit_account,credit_account,amount_cents,memo"
        TO CSV-LINE
    WRITE CSV-LINE

    PERFORM UNTIL WS-EOF = "Y"
        READ FLOW-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM PARSE-AND-POST
        END-READ
    END-PERFORM

    CLOSE FLOW-FILE
    CLOSE JOURNAL-FILE
    CLOSE JOURNAL-CSV
    DISPLAY "POST-FLOW: posted " WS-JE " entries"
    STOP RUN.

PARSE-AND-POST.
    IF WS-HEADER-SKIP = "Y"
        MOVE "N" TO WS-HEADER-SKIP
        EXIT PARAGRAPH
    END-IF
    IF FLOW-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-DIM-X
    MOVE SPACES TO WS-DEBIT
    MOVE SPACES TO WS-CREDIT
    MOVE SPACES TO WS-YEAR-X
    MOVE SPACES TO WS-AMT-X
    MOVE SPACES TO WS-MEMO
    MOVE 1 TO WS-PTR
    MOVE 0 TO WS-FCOUNT
    PERFORM SPLIT-CSV 6 TIMES
    IF WS-DEBIT = SPACES OR WS-CREDIT = SPACES
        EXIT PARAGRAPH
    END-IF
    IF WS-DEBIT = WS-CREDIT
        EXIT PARAGRAPH
    END-IF
    IF WS-DIM-X = SPACES
        MOVE 0 TO WS-DIM
    ELSE
        MOVE FUNCTION NUMVAL(WS-DIM-X) TO WS-DIM
    END-IF
    IF WS-YEAR-X = SPACES
        MOVE 2020 TO WS-YEAR
    ELSE
        MOVE FUNCTION NUMVAL(WS-YEAR-X) TO WS-YEAR
    END-IF
    IF WS-AMT-X = SPACES
        MOVE 100 TO WS-AMT
    ELSE
        MOVE FUNCTION NUMVAL(WS-AMT-X) TO WS-AMT
    END-IF
    IF WS-AMT <= 0
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DATE = WS-YEAR * 10000 + 615
    ADD 1 TO WS-JE
    MOVE WS-JE TO JE-ID
    MOVE WS-DATE TO JE-DATE
    MOVE WS-DIM TO JE-DIM
    MOVE " " TO JE-FILL
    MOVE WS-DEBIT TO DEBIT-ACCT
    MOVE WS-CREDIT TO CREDIT-ACCT
    MOVE WS-AMT TO AMOUNT-CENTS
    MOVE WS-MEMO TO MEMO
    MOVE JOURNAL-REC TO JOURNAL-LINE
    WRITE JOURNAL-LINE
    MOVE WS-JE TO WS-CSV-ID
    MOVE SPACES TO CSV-LINE
    STRING
        WS-CSV-ID DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        WS-DATE DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        WS-DIM DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(WS-DEBIT) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(WS-CREDIT) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        WS-AMT DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(WS-MEMO) DELIMITED BY SIZE
        INTO CSV-LINE
    END-STRING
    WRITE CSV-LINE.

SPLIT-CSV.
    MOVE SPACES TO WS-FIELD
    UNSTRING FLOW-LINE DELIMITED BY ","
        INTO WS-FIELD
        WITH POINTER WS-PTR
    END-UNSTRING
    ADD 1 TO WS-FCOUNT
    IF WS-FCOUNT = 1
        MOVE WS-FIELD TO WS-DIM-X
    END-IF
    IF WS-FCOUNT = 2
        MOVE WS-FIELD TO WS-DEBIT
    END-IF
    IF WS-FCOUNT = 3
        MOVE WS-FIELD TO WS-CREDIT
    END-IF
    IF WS-FCOUNT = 4
        MOVE WS-FIELD TO WS-YEAR-X
    END-IF
    IF WS-FCOUNT = 5
        MOVE WS-FIELD TO WS-AMT-X
    END-IF
    IF WS-FCOUNT = 6
        MOVE WS-FIELD TO WS-MEMO
    END-IF.
